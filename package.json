{
  "name": "aembi-play",
  "private": true,
  "version": "0.1.0",
  "description": "Aembi Play — plataforma de sinalização digital (digital signage)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @aembi-play/database generate",
    "db:migrate": "pnpm --filter @aembi-play/database migrate",
    "db:studio": "pnpm --filter @aembi-play/database studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.9.0",
    "prettier": "^3.4.0"
  }
}
