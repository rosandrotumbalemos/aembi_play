# ── Banco de dados (PostgreSQL) ──────────────────────────────────────────
POSTGRES_USER=aembi
POSTGRES_PASSWORD=aembi_dev_password
POSTGRES_DB=aembi_play
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aembi:aembi_dev_password@localhost:5432/aembi_play

# ── Armazenamento local (MinIO / S3-compatible) ──────────────────────────
MINIO_ROOT_USER=aembi_admin
MINIO_ROOT_PASSWORD=aembi_dev_password
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=aembi-ads
MINIO_USE_SSL=false
STORAGE_LOCAL_QUOTA_MB=1024

# ── Next.js (apps/web) ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# ── Player (apps/player) ─────────────────────────────────────────────────
NEXT_PUBLIC_PLAYER_MANIFEST_POLL_INTERVAL_MS=30000
NEXT_PUBLIC_PLAYER_HEARTBEAT_INTERVAL_MS=45000

# ── Worker (workers/media) ───────────────────────────────────────────────
WORKER_POLL_INTERVAL_SECONDS=5
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAX_UPLOAD_SIZE_MB=30
STORAGE_RETENTION_DAYS=7

# ── Google Drive (backup) ────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# ── Geral ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
